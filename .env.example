# Copy to .env (gitignored) and fill in before running docker-compose or
# apps/api directly. Never commit a real secret here.

# Any string >= 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Only needed when running apps/api outside docker-compose (which sets this
# itself). Matches docker-compose.yml's postgres service.
DATABASE_URL=postgres://rehab:rehab_dev_only@localhost:5432/rehab

# Comma-separated list of allowed origins for apps/api's CORS policy.
CORS_ORIGIN=http://localhost:5173

# apps/patient — set to run against a real apps/api instead of local-only.
# Leave unset to keep the guest-first, no-account flow (H7) as the default.
VITE_API_URL=http://localhost:3001

# apps/api — the between-sets coaching assistant (ADR-0009). Free key from
# https://console.groq.com. Leave unset to disable the coach entirely: the
# app hides it and everything else works unchanged.
GROQ_API_KEY=

# Optional. Defaults to llama-3.3-70b-versatile.
GROQ_MODEL=
