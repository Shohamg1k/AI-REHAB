# dependencies
node_modules/
.pnpm-store/

# build output
dist/
build/
*.tsbuildinfo

# env
.env
.env.local
.env.*.local

# datasets — never commit raw recordings or academic dataset files
fixtures/raw/

# editor / OS
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# test / coverage
coverage/
.vitest/

# vite
apps/*/dist/
apps/*/.vite/

# eval harness output — regenerated every run (pnpm eval / CI)
packages/eval/report.md

# MediaPipe pose assets — staged by scripts/fetch-pose-assets.mjs on install,
# not committed (wasm is reproducible from node_modules; the model is ~5.8MB).
apps/patient/public/mediapipe/

# Python (services/rehab-engine)
.venv/
__pycache__/
*.pyc
.pytest_cache/
