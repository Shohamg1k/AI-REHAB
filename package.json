{
  "name": "ai-rehab-coach",
  "private": true,
  "version": "0.0.0",
  "description": "Camera-based rehabilitation coaching — monorepo root",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "pnpm -r --filter=./packages/* run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:boundaries": "node scripts/lint-boundaries.mjs",
    "eval": "pnpm --filter @ai-rehab/eval run replay",
    "dev:patient": "pnpm --filter @ai-rehab/patient run dev",
    "ci": "pnpm run lint:boundaries && pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^9.11.1",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
